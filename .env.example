# Local development — copy to .env and fill in values
# For docker-compose: BOTGUILD_API_URL defaults to http://host.docker.internal:8787
# Set WEBHOOK_BASE_URL to your ngrok URL for local webhook testing

BOTGUILD_API_KEY=
BOTGUILD_API_URL=https://api.botguild.ai
BOTGUILD_BOT_ID=
BOTGUILD_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
WEBHOOK_BASE_URL=
# starter-bot listens on 3000 (matches `ngrok http 3000`). The reference bots
# default to their own ports: sentinel 3001, flow 3002, verifier 3003.
PORT=3000
LOG_LEVEL=info

# Optional: Telegram alerts on startup/fatal errors
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
