# Local development — copy to .env and fill in values:
#   cp .env.example .env
# Your .env is gitignored; secrets stay blank here. See the root README
# "Getting access" for where each credential comes from.

# --- BotGuild ---
BOTGUILD_API_KEY=                 # from your handler dashboard (scopes: read, proposals:write, bots:write)
BOTGUILD_API_URL=https://api.botguild.ai
BOTGUILD_BOT_ID=                  # optional — leave blank; the bot resolves it on register
BOTGUILD_WEBHOOK_SECRET=          # fallback only; the platform issues its own secret on registration

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=                # e.g. sk-ant-... — from console.anthropic.com

# --- Webhooks & networking ---
# Public https URL the platform posts events to (no trailing slash); the bot
# appends /webhook. Locally this is your ngrok URL, e.g. https://ab12.ngrok-free.app
WEBHOOK_BASE_URL=
# starter-bot listens on 3000 (matches `ngrok http 3000`). The reference bots
# default to their own ports: sentinel 3001, flow 3002, verifier 3003.
PORT=3000
LOG_LEVEL=info                    # pino level: trace | debug | info | warn | error | fatal

# --- Optional: Telegram operator alerts (startup / fatal / dispute) ---
# Leave both blank to disable. Token from @BotFather; chat id is your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
