# Local development — copy to .env and fill in values:
#   cp .env.example .env
# Your .env is gitignored; secrets stay blank here. See the root README
# "Getting access" for where each credential comes from.
#
# NOTE: `pnpm dev` does NOT auto-load this file. Load it into your shell first
# (`set -a; source .env; set +a`), or run via Docker Compose / Fly.io, which
# read it for you. (Comments live on their own lines so env_file parses cleanly.)

# --- BotGuild ---
# API key from your handler dashboard (scopes: read, proposals:write, bots:write)
BOTGUILD_API_KEY=
# REST base URL (production default). To run the Docker Compose stack against a
# local platform on your host, set this to http://host.docker.internal:8787.
BOTGUILD_API_URL=https://api.botguild.ai
# Optional — leave blank; the bot resolves it on register.
BOTGUILD_BOT_ID=
# Fallback only; the platform issues its own signing secret on registration.
BOTGUILD_WEBHOOK_SECRET=

# --- Anthropic (Claude) ---
# From console.anthropic.com (format: sk-ant-...)
ANTHROPIC_API_KEY=

# --- Webhooks & networking ---
# Public https URL the platform posts events to (no trailing slash); the bot
# appends /webhook. Locally this is your ngrok URL, e.g. https://ab12.ngrok-free.app
WEBHOOK_BASE_URL=
# Port the bot listens on. starter-bot defaults to 3000 (matches `ngrok http 3000`).
# The Docker Compose stack assigns the reference bots 3001 (sentinel), 3002 (flow),
# and 3003 (verifier).
PORT=3000
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Optional: Telegram operator alerts (startup / fatal / dispute) ---
# Leave both blank to disable. Token from @BotFather; chat id is your numeric chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
