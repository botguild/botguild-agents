// ThumbForge Worker configuration (PRD §7).
//
// Placeholder ids (marked ⚠️ REPLACE) must be filled in from `wrangler d1
// create` / `wrangler kv namespace create` output before a real deploy;
// `wrangler deploy --dry-run` works with the placeholders. Deploy the
// `thumbforge-probe` Worker FIRST so the PROBE service binding resolves.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thumbforge-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Required by agent-core's Buffer use (client.ts data:-URL attachments) —
  // mirrors the platform's own apps/api/wrangler.json.
  "compatibility_flags": ["nodejs_compat"],

  // Bundle the Inter OFL TTFs as raw bytes (§7). resvg/mozjpeg `.wasm` compile
  // via wrangler's built-in CompiledWasm rule — no extra rule needed; the fonts
  // need this Data rule so `import … from './fonts/*.ttf'` yields an ArrayBuffer.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],

  "vars": {
    // ⚠️ REPLACE with the deployed Worker's custom-domain URL (deliverable
    // links + webhook registration). Deliverables are served from this
    // route — NEVER the r2.dev dev domain (FR-9/FR-11).
    "WEBHOOK_BASE_URL": "https://thumbforge.example.com",
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thumbforge",
      // ⚠️ REPLACE with the id from `wrangler d1 create thumbforge`.
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],

  "kv_namespaces": [
    {
      "binding": "CACHE",
      // ⚠️ REPLACE with the id from `wrangler kv namespace create CACHE`.
      // Non-billing caches only (poller seen-gig ids) — never usage/idempotency.
      "id": "00000000000000000000000000000000",
    },
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "thumbforge-deliverables",
    },
  ],

  "queues": {
    "producers": [{ "binding": "RENDER_QUEUE", "queue": "thumbforge-render" }],
    "consumers": [
      {
        "queue": "thumbforge-render",
        // One graphic per message (§7/§12) — a pack fans out; never render a
        // whole 10-graphic pack in one ~30s CPU window.
        "max_batch_size": 1,
        // Transient errors only (Claude 5xx, D1/R2 hiccups); the DLQ parks
        // poison messages for operator replay (§12).
        "max_retries": 3,
        "dead_letter_queue": "thumbforge-render-dlq",
      },
      {
        // DLQ consumer: logs an operator alert per poisoned message (§12
        // runbook — replay by re-enqueueing to thumbforge-render).
        "queue": "thumbforge-render-dlq",
        "max_batch_size": 10,
        "max_retries": 0,
      },
    ],
  },

  "services": [
    {
      // The reachability URL-probe leg (§7/§9): a second Worker on its own
      // workers.dev hostname. Deploy thumbforge-probe first.
      "binding": "PROBE",
      "service": "thumbforge-probe",
    },
  ],

  "triggers": {
    // */10: gig poll + negotiation + reputation refresh.
    // 0 4:  daily usage rollover reconciliation + stuck-claim recovery.
    // 0 3 1: monthly recurring-gig re-post (usage report + re-fund prompt).
    "crons": ["*/10 * * * *", "0 4 * * *", "0 3 1 * *"],
  },

  "observability": { "enabled": true },

  // Secrets (set via `wrangler secret put <NAME>`; see .dev.vars.example):
  //   BOTGUILD_API_URL, BOTGUILD_API_KEY, BOTGUILD_BOT_ID,
  //   ANTHROPIC_API_KEY, YOUTUBE_API_KEY, ADMIN_TOKEN
  // The platform-issued webhook signing secret and per-offer CMS secrets are
  // NOT wrangler secrets — they are captured/generated at runtime and persisted
  // in D1 (§7/§10).
}
